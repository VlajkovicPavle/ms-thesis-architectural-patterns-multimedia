{
  "uid": "pipeline",
  "title": "Pipeline - Renditions",
  "tags": ["benchmark"],
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "variant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(rendition_active_jobs, variant)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(rendition_pipeline_duration_seconds_count{variant=~\"$variant\"}, service)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "In-flight jobs vs. queue backlog",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rendition_active_jobs{variant=~\"$variant\",service=~\"$service\"}", "legendFormat": "{{service}} active" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rendition_queue_size{variant=~\"$variant\",service=~\"$service\"}", "legendFormat": "{{service}} queued" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Throughput (renditions/sec) by status",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (service, status) (rate(rendition_pipeline_duration_seconds_count{variant=~\"$variant\",service=~\"$service\"}[1m]))", "legendFormat": "{{service}} {{status}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Rendition latency percentiles (incl. queue wait)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.5, sum by (le, service) (rate(rendition_pipeline_duration_seconds_bucket{variant=~\"$variant\",service=~\"$service\"}[5m])))", "legendFormat": "{{service}} p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, service) (rate(rendition_pipeline_duration_seconds_bucket{variant=~\"$variant\",service=~\"$service\"}[5m])))", "legendFormat": "{{service}} p95" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.99, sum by (le, service) (rate(rendition_pipeline_duration_seconds_bucket{variant=~\"$variant\",service=~\"$service\"}[5m])))", "legendFormat": "{{service}} p99" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Completed renditions by status",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rendition_pipeline_duration_seconds_count{variant=~\"$variant\",service=~\"$service\"}", "legendFormat": "{{service}} {{status}}" }
      ]
    }
  ]
}
